# Android
# Ignore Gradle artifacts
android/.gradle/
android/.idea/
android/local.properties
android/**/*.iml

# Ignore Android generated folders
android/app/build/
android/app/intermediates/
android/app/generated/
android/app/outputs/
android/app/.cxx/

# Ignore accidental case-sensitive folder issue
android/app/src/main/Kotlin/   # <- WRONG (capital K)
# DO NOT ignore correct kotlin folder:
# android/app/src/main/kotlin/

# Ignore signing files (never commit keystores)
*.jks
*.keystore
key.properties

